{
  "name": "@preflight/indexer-solana",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=../../.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:a2": "tsx scripts/txFetcher.test.ts",
    "test:a3": "tsx scripts/mintDecimals.test.ts",
    "test:c6": "tsx scripts/discoveryQueue.test.ts",
    "test:c1": "tsx scripts/registryWrite.test.ts",
    "test": "npm run test:a2 && npm run test:a3 && npm run test:c6 && npm run test:c1",
    "inspect:redis": "tsx --env-file=../../.env.local scripts/redisInspect.ts",
    "cleanup:redis": "tsx --env-file=../../.env.local scripts/redisCleanup.ts"
  },
  "dependencies": {
    "@preflight/schema": "*",
    "@solana/web3.js": "^1.98.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.22.2",
    "typescript": "^5"
  }
}
